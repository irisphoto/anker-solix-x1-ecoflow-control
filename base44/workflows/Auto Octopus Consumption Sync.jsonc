{
  "description": "Pulls new half-hourly smart-meter consumption from Octopus into EnergyReading daily so the History page stays up to date.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_octopus_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_octopus": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncOctopus",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync Octopus consumption",
            "description": "Incremental half-hourly readings"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Auto Octopus Consumption Sync"
}